"""
Nejbližší hráč – stabilní a deterministický výběr.

Proč to není jen AI: kdyby o shodě rozhodoval jazykový model, dostal bys
při každém načtení jiné jméno a občas nesmyslnou dvojici (rozehrávač vs.
střelec bez míče). Proto:

  1. Shoda se počítá deterministicky z reálných dat podle tří vah:
       - herní role a shot diet ..... 50 %
       - fyzický profil ............ 30 %
       - pokročilé poměry .......... 20 %
  2. AI (Gemini, temperature 0) dostane hotový seznam kandidátů a smí
     vybrat POUZE z něj – nemůže si vymyslet hráče ani změnit pořadí
     nesmyslným směrem. Když AI není k dispozici, výsledek je stejný,
     jen bez textového zdůvodnění.
  3. Výsledek se ukládá do tabulky `closest_cache` – druhý dotaz na
     stejného hráče je okamžitý a vrací přesně totéž.
"""

from __future__ import annotations

import json
import logging
import os
import threading
import unicodedata
from datetime import datetime
from typing import Any, Dict, List, Optional, Tuple

logger = logging.getLogger(__name__)

# Verze výpočtu – když se změní váhy nebo logika, stará cache se ignoruje.
ENGINE_VERSION = 1

WEIGHTS = {"style": 0.50, "physical": 0.30, "stats": 0.20}

# Pevné role, do kterých hráče zařadíme podle Usage Rate, asistencí a střelby.
ROLES = {
