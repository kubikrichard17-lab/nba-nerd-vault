    "paint_beast": "Paint beast (podkošová síla)",
    "combo_guard": "Combo guard (kombinovaný rozehrávač)",
    "stretch_big": "Stretch big (vytahující se pivot)",
    "point_forward": "Point forward (tvořivé křídlo s míčem)",
    "scoring_wing": "Scoring wing (křídlo, které skóruje z izolace)",
    "energy_big": "Energy big (pohyblivý podkošový hráč)",
    "post_scorer": "Post scorer (podkošový zakončovatel)",
    "post_hub": "Post hub (podkošový tvůrce hry)",
}

